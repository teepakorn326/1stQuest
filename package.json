{
  "name": "wish-circle",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "pnpm migrate && next build",
    "start": "next start",
    "lint": "eslint . && tsx scripts/lint-copy.ts",
    "lint:copy": "tsx scripts/lint-copy.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "db:local": "pglite-server --db=./.pglite --port=54329 --max-connections=10",
    "smoke": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/supabase-js": "^2.118.0",
    "clsx": "^2.1.1",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@electric-sql/pglite-socket": "^0.2.13",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
