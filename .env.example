# Supabase Postgres — pooled (transaction mode, port 6543) for the app
DATABASE_URL=
# Supabase session pooler (port 5432) for migrations — the direct db.* host is IPv6-only
DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
RESEND_API_KEY=
# Leave EMAIL_FROM empty to use dev mode (sign-in link shown on screen)
EMAIL_FROM=
# 32+ random bytes, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Public origin, e.g. https://wish-circle.vercel.app (no trailing slash)
APP_URL=http://localhost:3000

# Local dev without Docker: run `pnpm db:local`, then use
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# DIRECT_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
# DB_POOL_MAX=1   (PGlite is a single session)
